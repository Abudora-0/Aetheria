# =============================================================================
# Aetheria environment
# Every value here is optional. With none set, the app boots in demo mode with
# a seeded in-memory dataset. Add real values to switch subsystems to live.
# =============================================================================

# Public base URL (used for OAuth redirects, Stripe return URLs, OG metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Data source -----------------------------------------------------------
# auto  -> live when MONGODB_URI is set, demo otherwise
# demo  -> always the in-memory dataset
# live  -> always MongoDB (fails fast if MONGODB_URI is missing)
DATA_MODE=auto
MONGODB_URI=

# ----- Auth ------------------------------------------------------------------
# 32+ random chars. Generate: openssl rand -base64 48
JWT_SECRET=
# 32 byte key (hex or base64) for encrypting stored OAuth tokens. openssl rand -hex 32
TOKEN_ENC_KEY=

# ----- Scheduling worker ---------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer <value>`. Required in prod.
CRON_SECRET=

# ----- Transactional email (Resend). Absent -> emails are logged, not sent --
RESEND_API_KEY=
EMAIL_FROM="Aetheria <noreply@yourdomain.com>"

# ----- Media (Cloudinary). Absent -> deterministic placeholder images --------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Billing (Stripe). Absent -> the "simulate" billing path --------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_PORTAL_RETURN_URL=

# ----- Social OAuth apps. Absent -> a sandbox channel is created instead ----
# Register each app with this redirect / callback URL:
#   <NEXT_PUBLIC_APP_URL>/api/oauth/<network>/callback
#   e.g. https://your-app.vercel.app/api/oauth/twitter/callback
# Twitter needs OAuth 2.0 with PKCE and the tweet.write + offline.access scopes.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
